<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/corporativo1"
    tools:context=".MainActivity9formulario_post">

    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/appBarLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <androidx.appcompat.widget.Toolbar
            android:id="@+id/tb9"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="?attr/colorPrimary"
            android:theme="?attr/actionBarTheme" />

    </com.google.android.material.appbar.AppBarLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Contenedor de imagen que se redimensiona -->
            <FrameLayout
                android:id="@+id/imageContainer"
                android:layout_width="match_parent"
                android:layout_height="100dp"
                android:layout_marginBottom="8dp">

                <ImageView
                    android:id="@+id/iv9"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="centerCrop"
                    android:contentDescription="Imagen seleccionada" />

                <!-- Icono de galería (visible cuando no hay imagen) -->
                <ImageView
                    android:id="@+id/iconGallery"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_gravity="center"
                    android:src="@android:drawable/ic_menu_gallery"
                    android:contentDescription="Añadir imagen"
                    app:tint="@android:color/darker_gray" />

                <!-- Texto "Añadir imagen" (visible cuando no hay imagen) -->
                <TextView
                    android:id="@+id/textAddImage"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:layout_marginTop="60dp"
                    android:text="Añadir imagen"
                    android:textColor="@android:color/darker_gray" />

                <!-- Botón X rojo para eliminar imagen (invisible al inicio) -->
                <ImageButton
                    android:id="@+id/btnRemoveImage"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:layout_gravity="top|end"
                    android:layout_margin="8dp"
                    android:src="@android:drawable/ic_menu_close_clear_cancel"
                    app:tint="#F44336"
                    android:background="@android:color/transparent"
                    android:contentDescription="Eliminar imagen"
                    android:visibility="gone" />

            </FrameLayout>

            <!-- EditText -->
            <EditText
                android:id="@+id/tv9"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="top|start"
                android:hint="¿Qué quieres compartir con Pingu?"
                android:inputType="textMultiLine|textCapSentences"
                android:maxLines="10"
                android:minLines="5"
                android:padding="12dp"
                android:scrollbars="vertical"
                android:background="@android:color/transparent" />

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

</androidx.coordinatorlayout.widget.CoordinatorLayout>